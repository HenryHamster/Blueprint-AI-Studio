# ==============================================================================
# ARCHIVED — NOT LOADED BY TERRAFORM
#
# This file is the previous AlloyDB cluster definition. It was archived to
# prevent the ~$1800/mo always-on AlloyDB bill on fresh deploys. Cloud SQL
# (`cloud_sql.tf`) is the active database.
#
# To restore: see archive/README.md (skip the VPC peering block below — that
# moved to vpc.tf and stays there).
#
# DO NOT enable this file (rename to *.tf) without first reading the README.
# ==============================================================================

# ------------------------------------------------------------------------------
# AlloyDB Cluster & Instance
# ------------------------------------------------------------------------------

# Generate a random suffix for the cluster ID to avoid naming collisions
resource "random_id" "cluster_id_suffix" {
  byte_length = 4
}

# Generate a secure random password for the default 'postgres' user
resource "random_password" "db_password" {
  length           = 16
  special          = true
  override_special = "_%@"
}

resource "google_alloydb_cluster" "default" {
  cluster_id = "orchestrator-alloydb-${random_id.cluster_id_suffix.hex}"
  location   = var.region

  network_config {
    network = google_compute_network.agent_vpc.id
  }

  initial_user {
    user     = "postgres"
    password = random_password.db_password.result
  }

  # Ensure the private connection is established before creating the cluster
  # NOTE: vpc_connection now lives in vpc.tf (not alloydb.tf) — the resource
  # address is unchanged, this depends_on still works after restore.
  depends_on = [google_service_networking_connection.vpc_connection]
}

resource "google_alloydb_instance" "primary" {
  cluster       = google_alloydb_cluster.default.name
  instance_id   = "orchestrator-alloydb-primary"
  instance_type = "PRIMARY"

  machine_config {
    cpu_count = 2 # Minimum vCPUs for AlloyDB
  }

  client_connection_config {
    require_connectors = false
    ssl_config {
      ssl_mode = "ENCRYPTED_ONLY"
    }
  }

  database_flags = {
    "alloydb.enable_pgaudit"      = "on"
    "pgaudit.log"                 = "ddl,role,write"
    "password.enforce_complexity" = "on"
    "alloydb.iam_authentication"  = "on"
  }
}

# ------------------------------------------------------------------------------
# Database Credentials (Secret Manager)
# ------------------------------------------------------------------------------

resource "google_secret_manager_secret" "db_password_secret" {
  secret_id = "alloydb-postgres-password"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "db_password_version" {
  secret      = google_secret_manager_secret.db_password_secret.id
  secret_data = random_password.db_password.result
}

resource "google_secret_manager_secret_iam_member" "orchestrator_db_password_access" {
  secret_id = google_secret_manager_secret.db_password_secret.id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.orchestrator_sa.email}"
}
