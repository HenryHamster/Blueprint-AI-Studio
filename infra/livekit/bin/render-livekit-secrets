#!/usr/bin/env bash
# Fetch pinned LiveKit runtime material from Google Secret Manager. This script
# is called by the root-owned systemd service before Docker starts; containers
# receive mounted files, never Google credentials or Secret Manager references.
set -Eeuo pipefail

readonly CONFIG_DIR="${BLUEPRINT_LIVEKIT_CONFIG_DIR:-/etc/blueprint-livekit}"
readonly REFS_FILE="$CONFIG_DIR/secret-refs"
readonly PUBLIC_ENV_FILE="$CONFIG_DIR/public.env"
readonly RUNTIME_DIR="${BLUEPRINT_LIVEKIT_RUNTIME_DIR:-/run/blueprint-livekit}"
# The root-owned service writes files for the image's unprivileged uid. The
# containers receive only those mounts, never the Google credential context.
readonly LIVEKIT_UID="${BLUEPRINT_LIVEKIT_UID:-65532}"
readonly LIVEKIT_GID="${BLUEPRINT_LIVEKIT_GID:-$LIVEKIT_UID}"
readonly GCLOUD_BIN="${BLUEPRINT_LIVEKIT_GCLOUD:-gcloud}"

check_only=false
if [[ $# -eq 1 && "$1" == "--check" ]]; then
  check_only=true
elif [[ $# -ne 0 ]]; then
  echo "usage: $0 [--check]" >&2
  exit 2
fi

if [[ ! -r "$REFS_FILE" ]]; then
  echo "missing root-readable $REFS_FILE" >&2
  exit 1
fi
if [[ ! -r "$PUBLIC_ENV_FILE" ]]; then
  echo "missing root-readable $PUBLIC_ENV_FILE" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$REFS_FILE"
# shellcheck source=/dev/null
source "$PUBLIC_ENV_FILE"

require_value() {
  local name="$1"
  if [[ -z "${!name:-}" ]]; then
    echo "missing required setting: $name" >&2
    exit 1
  fi
}

parse_secret_ref() {
  local reference="$1"
  if [[ ! "$reference" =~ ^projects/([a-z][a-z0-9-]{4,28}[a-z0-9])/secrets/([A-Za-z0-9_-]{1,255})/versions/([1-9][0-9]*)$ ]]; then
    echo "secret reference must be an explicitly numbered projects/.../secrets/.../versions/N resource" >&2
    exit 1
  fi
  SECRET_PROJECT="${BASH_REMATCH[1]}"
  SECRET_NAME="${BASH_REMATCH[2]}"
  SECRET_VERSION="${BASH_REMATCH[3]}"
}

read_secret() {
  local reference="$1"
  local destination="$2"
  parse_secret_ref "$reference"
  # gcloud uses the GCE attached service account via the metadata server. It
  # writes only the payload to the restrictive temporary path, never stdout.
  "$GCLOUD_BIN" secrets versions access "$SECRET_VERSION" \
    --project="$SECRET_PROJECT" \
    --secret="$SECRET_NAME" >"$destination"
}

require_value LIVEKIT_CONFIG_SECRET
require_value LIVEKIT_TURN_CERT_SECRET
require_value LIVEKIT_TURN_KEY_SECRET
require_value LIVEKIT_TURN_HOST

if "$check_only"; then
  temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/blueprint-livekit-render.XXXXXX")"
else
  install -d -m 0700 "$RUNTIME_DIR"
  temporary_dir="$(mktemp -d "$RUNTIME_DIR/.render.XXXXXX")"
fi
cleanup() { rm -rf -- "$temporary_dir"; }
trap cleanup EXIT
umask 077

read_secret "$LIVEKIT_CONFIG_SECRET" "$temporary_dir/livekit.yaml"
read_secret "$LIVEKIT_TURN_CERT_SECRET" "$temporary_dir/turn.crt"
read_secret "$LIVEKIT_TURN_KEY_SECRET" "$temporary_dir/turn.key"

for file in "$temporary_dir/livekit.yaml" "$temporary_dir/turn.crt" "$temporary_dir/turn.key"; do
  if [[ ! -s "$file" ]]; then
    echo "Secret Manager returned an empty LiveKit runtime file" >&2
    exit 1
  fi
done

# Cheap, dependency-free guardrails catch the most dangerous accidental secret
# and topology errors before a replacement service can interrupt a live call.
grep -q '^keys:' "$temporary_dir/livekit.yaml"
grep -q '^  enabled: true' "$temporary_dir/livekit.yaml"
grep -q '^  tcp_port: 7881' "$temporary_dir/livekit.yaml"
grep -q '^  port_range_start: 50000' "$temporary_dir/livekit.yaml"
grep -q '^  port_range_end: 60000' "$temporary_dir/livekit.yaml"
grep -q '^  tls_port: 443' "$temporary_dir/livekit.yaml"
grep -q '^  cert_file: /run/blueprint-livekit/turn.crt' "$temporary_dir/livekit.yaml"
grep -q '^  key_file: /run/blueprint-livekit/turn.key' "$temporary_dir/livekit.yaml"
grep -q -- '-----BEGIN CERTIFICATE-----' "$temporary_dir/turn.crt"
grep -Eq -- '-----BEGIN (EC |RSA )?PRIVATE KEY-----' "$temporary_dir/turn.key"

# TURN/TLS has a separate public address from WSS. The configuration secret is
# authoritative for what clients receive, while public.env is authoritative for
# the TCP proxy/DNS boundary. Refuse either a typo or accidental reuse of the
# WSS hostname before replacing the running gateway.
turn_domain="$(awk '
  /^[[:space:]]*turn:[[:space:]]*($|#)/ { in_turn = 1; next }
  in_turn && /^[^[:space:]]/ { in_turn = 0 }
  in_turn && /^[[:space:]]+domain:[[:space:]]*/ { print $2; exit }
' "$temporary_dir/livekit.yaml")"
if [[ -z "$turn_domain" || "$turn_domain" != "$LIVEKIT_TURN_HOST" ]]; then
  echo "TURN domain mismatch: livekit.yaml turn.domain must equal LIVEKIT_TURN_HOST" >&2
  exit 1
fi

if "$check_only"; then
  echo "LiveKit secret material and TURN host contract OK."
  exit 0
fi

# Atomic renames mean the container observes an old complete set or a new
# complete set, never a partially written credential file.
install -m 0400 -o "$LIVEKIT_UID" -g "$LIVEKIT_GID" "$temporary_dir/livekit.yaml" "$RUNTIME_DIR/livekit.yaml.next"
install -m 0400 -o "$LIVEKIT_UID" -g "$LIVEKIT_GID" "$temporary_dir/turn.crt" "$RUNTIME_DIR/turn.crt.next"
install -m 0400 -o "$LIVEKIT_UID" -g "$LIVEKIT_GID" "$temporary_dir/turn.key" "$RUNTIME_DIR/turn.key.next"
mv -f "$RUNTIME_DIR/livekit.yaml.next" "$RUNTIME_DIR/livekit.yaml"
mv -f "$RUNTIME_DIR/turn.crt.next" "$RUNTIME_DIR/turn.crt"
mv -f "$RUNTIME_DIR/turn.key.next" "$RUNTIME_DIR/turn.key"
