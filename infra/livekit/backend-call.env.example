# Deploy this through the backend platform's secret/environment mechanism, not
# from a file on a runner or the LiveKit gateway VM. Values below are examples;
# do not place a secret payload in this file.
LIVEKIT_URL=wss://livekit.example.com

# These are platform secret-mount selectors. Pin a numeric version and arrange
# for the resulting payload to be exposed as LIVEKIT_API_KEY/API_SECRET.
LIVEKIT_API_KEY=blueprint-livekit-api-key:1
LIVEKIT_API_SECRET=blueprint-livekit-api-secret:1

# These remain resource references in the backend environment. The backend
# resolves them only while preparing the authenticated Resident call envelope.
CALL_DEEPGRAM_API_KEY_SECRET_VERSION=projects/your-gcp-project/secrets/blueprint-call-deepgram-api-key/versions/1
CALL_CARTESIA_API_KEY_SECRET_VERSION=projects/your-gcp-project/secrets/blueprint-call-cartesia-api-key/versions/1
CALL_DEEPGRAM_STT_MODEL=flux-general-en
CALL_CARTESIA_TTS_MODEL=sonic-3
CALL_CARTESIA_VOICE_ID=your-reviewed-cartesia-voice-id

# Fail-closed production attestation. Set this exact value only after the
# real-account latency, interruption, fidelity, and isolation gates pass.
# CALL_FOREGROUND_QUALIFICATION=claude-warm-stream-json:phase0-v1
