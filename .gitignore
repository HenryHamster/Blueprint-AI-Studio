# Agent runtime tool scripts (auto-generated in workspace, must not be committed)
# .check-task: per-task generated gate written by writeCheckHelper for Blueprint
# self-repo. The static ./check delegates to it when present; operators use the
# static file directly. Must not be committed.
/.check-task
/check
/note
/messages
/playbook
/design-doc
/strategic
/suggest
/blocked
/gh-token
/pr
/done
/fail
/fetch
/compute-image
/artifacts
/symbols
/viewport-snapshot
/viewport-live
research-*.md
*.bak
# Repo-root self-review JSON output (agents write to /tmp; strays at the root
# are generated noise). Root-anchored so nested fixtures like
# backend/testing/**/self_review_*.json are not ignored.
/self_review_*.json

# Local git worktrees spawned by Claude Code — never commit as gitlinks
.claude/worktrees/
.claude/bin/

# Local task-tooling (ruff binary shim, ruff python module, backend venv, postgres binaries)
.local-bin/
.ruff-module/
.backend-venv/
.pgbin/

# Local build sources and extracted trees; never commit scratch artifacts.
/.scratch/

# Duration-merge scratch. NOT backend/.test_durations itself -- that artifact is
# committed and backend/testing/test_audit_finding_class_guards.py fails if this
# file ever lists it.
#   *.lock             the sidecar scripts/merge_durations.py takes its OS
#                      advisory lock on; zero-length and reused across runs.
#   .duration_refresh.* the raw pytest-split measurement scripts/store-backend-
#                      durations.sh retains when a merge fails, so the run can
#                      be merged again without re-measuring.
backend/.test_durations.lock
backend/.duration_refresh.*
