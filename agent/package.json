{
  "name": "blueprint-agent",
  "version": "2.0.0",
  "description": "Claude Code agent runner for Blueprint PVM launcher",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@livekit/rtc-node": "0.13.31",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.10.4",
    "@types/ws": "^8.5.10",
    "eslint": "^9.0.0",
    "tsx": "^4.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
