{
  "name": "blueprint-launcher",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "admin-ui"
  ],
  "overrides": {},
  "scripts": {
    "dev": "concurrently --raw \"vite --port=3000 --host=0.0.0.0\" \"npm run dev --prefix admin-ui\"",
    "dev:root": "vite --port=3000 --host=0.0.0.0",
    "dev:admin": "npm run dev --prefix admin-ui",
    "build": "vite build && npm run build --prefix admin-ui",
    "preview": "vite preview",
    "clean": "rm -rf dist && rm -rf admin-ui/dist",
    "lint": "npm run lint --prefix admin-ui"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^4.4.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
