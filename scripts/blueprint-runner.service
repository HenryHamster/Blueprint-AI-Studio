# Blueprint local fleet runner — systemd --user unit TEMPLATE
#
# This is a TEMPLATE, not a ready-to-use unit. Do NOT hand-edit and copy it.
# `blueprint-runner install` renders it (substituting @PYTHON@, @LOCAL_RUNNER@,
# and @ENV_FILE@ with the real absolute paths resolved on this host), writes the
# result to ~/.config/systemd/user/blueprint-runner.service, and runs
# daemon-reload + enable --now + loginctl enable-linger for you. Uninstall with
# `blueprint-runner uninstall`.
#
# ENVIRONMENT FILE (@ENV_FILE@ — defaults to ~/.blueprint/runner.env):
#   Optional 0600 file with runner config (the leading `-` means "ignore if
#   absent"). After the first successful start BLUEPRINT_RUNNER_TOKEN is
#   persisted to ~/.blueprint/runner_token, so the service picks the token up
#   from there on every subsequent start with nothing baked into this unit.
#
# RESTART — crash recovery AND self-update:
#   Restart=always restarts the runner whenever it exits, for ANY reason. Two
#   exit paths depend on this:
#     * crash / fatal condition — the runner calls os._exit(1) (via _die()) on a
#       revoked token or a supervisor-detected fatal error; systemd relaunches it.
#     * self-update — after pulling a newer version the runner exits 0 and trusts
#       its supervisor to relaunch the fresh binary (see _reexec_after_update,
#       which os._exit(0)s once it detects it is a systemd service unit). Under
#       Restart=on-failure that clean exit-0 is NOT restarted, so a self-updating
#       runner silently stays dead until a manual restart — hence `always`.
#   A deliberate operator `systemctl --user stop` is still honored: systemd never
#   applies the restart policy to an operator-initiated stop, so it stays stopped.
#
#   A burst cap (StartLimitIntervalSec=60 / StartLimitBurst=3) prevents a
#   persistent failure (full disk, revoked token, broken isolation binary) from
#   restarting forever at 5 s intervals — after 3 restarts within 60 s systemd
#   moves the unit to a terminal failed state. To recover after fixing the root
#   cause, run:  systemctl --user reset-failed blueprint-runner.service
#
# VIEWING LOGS:
#   journalctl --user -u blueprint-runner.service -f

[Unit]
Description=Blueprint local fleet runner
Documentation=https://github.com/your-org/your-repo/blob/main/docs/runner-install.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=@PYTHON@ @LOCAL_RUNNER@
Restart=always
RestartSec=5
# Load credentials and config from a 0600 file outside the repo (`-` = optional).
EnvironmentFile=-@ENV_FILE@
# Redirect stdout/stderr into the systemd journal (view with journalctl --user).
StandardOutput=journal
StandardError=journal
# Propagate SIGTERM cleanly so the runner shuts down gracefully before systemd
# sends SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
