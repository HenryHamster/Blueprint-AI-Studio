[Unit]
Description=Safely prune unused anonymous volumes from Blueprint Actions Docker daemons
After=local-fs.target
ConditionPathIsDirectory=/var/lib/blueprint-actions

[Service]
Type=oneshot
ExecStart=/usr/local/lib/blueprint/github-actions-vm/prune-runner-volumes.sh
ExecStopPost=/usr/local/lib/blueprint/github-actions-vm/thaw-owned-runners.sh
RuntimeMaxSec=5min
TimeoutStartSec=5min
User=root
Group=root
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/blueprint-actions
ReadWritePaths=/run/lock
ReadWritePaths=/run/blueprint-actions-volume-gc
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
Nice=10
IOSchedulingClass=idle
MemoryMax=256M
