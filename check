#!/usr/bin/env bash
# Canonical Blueprint local-gate entrypoint.
#
# The task runtime generates the self-repo gate at .check-task. This tracked
# wrapper deliberately contains no task-specific configuration or fallback
# implementation: every local publication command reaches the generated gate.

set -uo pipefail

WORKSPACE="${WORKSPACE:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
export WORKSPACE
TASK_GATE="$WORKSPACE/.check-task"
DEFAULT_GATE="$WORKSPACE/scripts/check-default.sh"

if [ -n "${TASK_ID:-}" ]; then
  # A failed/missing generated gate must not leave a prior negative capability
  # receipt available for ./fail to consume as if it belonged to this attempt.
  CAPABILITY_RECEIPT="/tmp/execution_capability_receipt_${TASK_ID}"
  if ! rm -f "$CAPABILITY_RECEIPT"; then
    echo "[check] ERROR: cannot clear stale capability receipt: $CAPABILITY_RECEIPT" >&2
    exit 2
  fi

fi

if [ -f "$TASK_GATE" ]; then
  if [ ! -x "$TASK_GATE" ]; then
    echo "[check] ERROR: generated self-repo gate is not executable: $TASK_GATE" >&2
    exit 2
  fi
  exec "$TASK_GATE" "$@"
fi

if [ -n "${TASK_ID:-}" ]; then
  echo "[check] ERROR: generated self-repo gate is missing: $TASK_GATE" >&2
  exit 2
fi

if [ ! -x "$DEFAULT_GATE" ]; then
  echo "[check] ERROR: tracked developer gate is missing or not executable: $DEFAULT_GATE" >&2
  exit 2
fi

exec "$DEFAULT_GATE" "$@"
