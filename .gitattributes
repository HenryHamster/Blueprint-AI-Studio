# Custom merge driver for the size-guardrail caps file. Parallel in-flight PRs
# routinely each bump a cap in this one shared JSON, producing textual conflicts
# whose intent never actually conflicts (policy only ever raises caps). The
# `sizecap` driver performs a max-cap union merge so those conflicts auto-resolve.
#
# A .gitattributes entry alone does NOT activate the driver — git requires the
# `merge.sizecap.driver` command to be registered in the repo's local git config,
# which a clone does not carry. The agent's workspace-prep step installs that
# config (registerSizeCapMergeDriver). See backend/testing/merge_size_limits.py.
backend/testing/module_size_limits.json merge=sizecap

# The agent Cloud Run Job build context must stay LF regardless of core.autocrlf.
# A CRLF Dockerfile/.dockerignore handed to Cloud Build / docker can mis-parse
# (RUN line-continuations, ignore patterns) on some engines.
agent/Dockerfile text eol=lf
agent/.dockerignore text eol=lf

# LiveKit gateway files are installed on Linux hosts, including when packaged
# from a Windows local runner. Keep shell and service definitions free of CRLF.
infra/livekit/bin/* text eol=lf
scripts/blueprint-livekit-system.service text eol=lf

# Local release bootstrap files are transferred from developer worktrees and
# executed directly on Linux. CRLF corrupts their env/python shebangs.
scripts/*release*.py text eol=lf

# Actions VM installers and guest systemd assets are transferred as executable
# deployment artifacts. Archive/check-out behavior must not introduce CRLF.
scripts/install-github-actions-vm.sh text eol=lf
scripts/github-actions-vm/*.sh text eol=lf
scripts/github-actions-vm/*.service text eol=lf
scripts/github-actions-vm/*.timer text eol=lf
