# Custom merge driver for the size-guardrail caps file. Parallel in-flight PRs
# routinely each bump a cap in this one shared JSON, producing textual conflicts
# whose intent never actually conflicts (policy only ever raises caps). The
# `sizecap` driver performs a max-cap union merge so those conflicts auto-resolve.
#
# A .gitattributes entry alone does NOT activate the driver — git requires the
# `merge.sizecap.driver` command to be registered in the repo's local git config,
# which a clone does not carry. The agent's workspace-prep step installs that
# config (registerSizeCapMergeDriver). See backend/testing/merge_size_limits.py.
backend/testing/module_size_limits.json merge=sizecap

# Custom merge driver for the backend duration measurements. Same defect shape
# as the size caps above: parallel in-flight PRs each ADD entries for the tests
# they add, so the intent never conflicts, but appending to a JSON object
# rewrites the previous last line to give it a comma -- both sides edit that one
# line and git reports a textual conflict on a ~21000-line file. Every merge
# into automain then re-conflicts every other open PR.
#
# The `testdurations` driver takes the union after PROVING both sides are
# insert-only against the merge base, and leaves the conflict in place
# otherwise, so a re-timed or deleted measurement still reaches a human.
# The stock `merge=union` driver is NOT a safe spelling of this: appending on
# both sides makes it emit a duplicate key and a missing comma -- invalid JSON,
# reported as a SUCCESSFUL merge. See the module docstring for the reproduction.
#
# As with sizecap, a .gitattributes entry alone does NOT activate the driver;
# `merge.testdurations.driver` must be registered in the repo's local git config,
# which a clone does not carry. registerDerivedArtifactMergeDrivers in
# agent/src/index.ts installs it at every workspace-prep site.
backend/.test_durations merge=testdurations

# The agent Cloud Run Job build context must stay LF regardless of core.autocrlf.
# A CRLF Dockerfile/.dockerignore handed to Cloud Build / docker can mis-parse
# (RUN line-continuations, ignore patterns) on some engines.
agent/Dockerfile text eol=lf
agent/.dockerignore text eol=lf

# LiveKit gateway files are installed on Linux hosts, including when packaged
# from a Windows local runner. Keep shell and service definitions free of CRLF.
infra/livekit/bin/* text eol=lf
scripts/blueprint-livekit-system.service text eol=lf

# Local release bootstrap files are transferred from developer worktrees and
# executed directly on Linux. CRLF corrupts their env/python shebangs.
scripts/*release*.py text eol=lf

# Actions VM installers and guest systemd assets are transferred as executable
# deployment artifacts. Archive/check-out behavior must not introduce CRLF.
scripts/install-github-actions-vm.sh text eol=lf
scripts/blueprint-actions-vm.service text eol=lf
scripts/migrate-container-storage.sh text eol=lf
scripts/github-actions-vm/*.sh text eol=lf
scripts/github-actions-vm/*.service text eol=lf
scripts/github-actions-vm/*.timer text eol=lf

# Generated artifacts regenerated by hand on developer hosts. Their writers now
# pin newline="" so the bytes they emit are LF on every platform, but the pin
# alone protects only files written by THOSE writers; these entries make the
# LF contract a property of the path, so a stray CRLF write (an editor, a
# different tool, a future generator) still normalizes on the way in instead of
# landing as a whole-file diff that conflicts with every concurrent branch.
# Without them, only a developer happening to have core.autocrlf=input stood
# between `--write`/`--fix` on Windows and a ~1050-row phantom diff.
test-estate-ranked-queue.md text eol=lf
backend/.test_durations text eol=lf
backend/testing/module_size_limits.json text eol=lf
backend/testing/cap_bump_history.json text eol=lf
admin-ui/.test_durations.json text eol=lf
agent/.test_durations.json text eol=lf

# GitHub should collapse reproducible timing data and the generated test report
# in diffs. These files remain tracked at the paths used by validation tooling.
backend/.test_durations linguist-generated=true
admin-ui/.test_durations.json linguist-generated=true
agent/.test_durations.json linguist-generated=true
test-estate-ranked-queue.md linguist-generated=true
