# Server API Keys
ADMIN_API_KEY=your_secure_admin_api_key_here

# Frontend API Keys (Must match ADMIN_API_KEY for the UI to work)
VITE_ADMIN_API_KEY=your_secure_admin_api_key_here

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://your-admin-ui-domain.com

# GCP Configuration (Required for orchestrator to spin up VPMs)
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-central1-a

# VPM Configuration
MACHINE_TYPE=e2-standard-2
VPC_NETWORK=agent-sandbox-vpc
VPC_SUBNET=agent-sandbox-subnet
AGENT_IMAGE_FAMILY=projects/your-gcp-project-id/global/images/family/blueprint-agent
AGENT_SERVICE_ACCOUNT_EMAIL=vpm-worker@your-gcp-project-id.iam.gserviceaccount.com

# The public/internal URL of your orchestrator (so agent VMs know where to report back)
ORCHESTRATOR_URL=http://your-orchestrator-url:8080

# GitHub App Configuration (Required for repo access — see Deploy.md section 5)
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nyour-key-here\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db:5432/postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Agent JWT Secret (Used to sign tokens for VPMs)
AGENT_JWT_SECRET=your_secure_agent_jwt_secret_here

# WebSocket Ticket Secret
WS_TICKET_SECRET=your_secure_ws_ticket_secret_here

# Field-level encryption key. The compose `app` service and migration 0609's
# fail-closed reconciliation REQUIRE this to be set. Generate a real key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The placeholder below is a DEV-ONLY stand-in (not a valid Fernet key).
GITHUB_PAT_ENCRYPTION_KEY=your_secure_fernet_key_here

# Claude Code Auth — Primary: Max plan (pre-authenticated via `claude login` on VM image)
# Fallback: Set ANTHROPIC_API_KEY to use the Anthropic API directly instead.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Mode (Set to "true" to run agents as local subprocesses instead of GCP VMs)
LOCAL_MODE=false

# Max Concurrent VMs (limits how many agent VMs can run simultaneously, 1-30)
MAX_CONCURRENT_VMS=5

# Metrics endpoint token (Optional — /metrics is unauthenticated by default; set this to require token auth)
METRICS_TOKEN=your_secure_metrics_token_here
